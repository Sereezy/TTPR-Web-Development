<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EJS Tags</title>
</head>

<body>
  <h1>
    <!-- Title goes here -->
    <%= title %>
  </h1>
  <p>Current second:
    <!-- Current second goes here -->
     <%= seconds %>
  </p>
  <% if (seconds % 2 === 0) { %>
      <% for (let i =0; i < items.length; i++) { %>
    <li><%=items[i] %></li>
      <% } %>
<% } else { %>
  <p>No items to display</p>
   <% } %>
  <p>
    <%=htmlContent %>
  </p>

  <!-- Footer goes here -->
</body>

</html>