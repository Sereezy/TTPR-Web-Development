<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EJS Tags</title>
</head>

<body>
  <h1>
    <%= title %>
      <!-- Title goes here -->
  </h1>
  <p>Current second:
    <%= seconds %>
      <!-- Current second goes here -->
  </p>
  <% if (seconds % 2===0) {%>
    <ul>
      <% items.forEach(function(item){ %>
        <li>
          <%= item %>
            <!-- Item goes here -->
        </li>
        <% }) %>
    </ul>
    <% } else {%>
      <p>No items to display</p>
      <% } %>
        <p>
          <%- htmlContent %>
            <!-- HTML content goes here -->
        </p>
        <%- include('./footer.ejs') %>
          <!-- Footer goes here -->
</body>

</html>
